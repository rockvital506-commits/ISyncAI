# Python virtual environments & caches (synchronized with isai.constitution.BoundaryIgnoreSpec)
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
# Versioned standalone distribution; other build outputs stay untracked.
!/dist/
/dist/*
!/dist/AgentContractKit-0.1.0.zip
.isai_tmp_*
.isai_write.lock
